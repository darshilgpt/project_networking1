# Environment Variables for Vite React Frontend
# Copy to .env.local for local overrides. Do not commit secrets.

# Backend FastAPI REST API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend WebSocket monitor URL
VITE_WS_URL=ws://127.0.0.1:8000/ws/monitor

# WebSocket Authentication Token (optional in dev if WS_ALLOW_ANONYMOUS_DEV=true)
VITE_WS_TOKEN=dpi-admin-secret-key

# Fallback to Sample Data when backend is offline (true | false)
VITE_USE_SAMPLE_DATA_FALLBACK=false

