    "match_type": "regex",
    "severity": "HIGH",
    "action": "ALERT"
  },
  {
    "id": 1007,
    "name": "Blacklisted TLS SNI Domain",
    "protocol": "TLS",
    "field": "sni",
    "pattern": "(malware|phishing|c2server)\\.",
    "match_type": "regex",
    "severity": "HIGH",
    "action": "BLOCK"
  },
  {
    "id": 1008,
    "name": "Raw Payload Web Shell Signature",
    "protocol": "ANY",
